# Copy to apps/api/.env for the API, and set API_ORIGIN in the environment for the web
# client. Never commit real secrets (coding standard, section 4).

# ---------------------------------------------------------------------------
# API (apps/api/.env)
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Storage engine. Leave blank and the API picks MongoDB when MONGODB_URI is set and the
# JSON file otherwise. Set it to `json` to force the file even while a URI is configured,
# or to `mongodb` to make a missing URI a boot failure instead of a silent fallback.
DATABASE_DRIVER=

# MongoDB connection string. A local server, or an Atlas `mongodb+srv://` URI.
#   MONGODB_URI=mongodb://127.0.0.1:27017/hungry_ju
# Multi-document transactions need a replica set; a standalone mongod runs everything
# else, and the API logs which of the two it got at boot.
MONGODB_URI=

# Database inside that deployment. Blank means "whatever the URI names".
MONGODB_DB_NAME=

# Where the JSON database file lives, when that engine is in use. Defaults to
# apps/api/data/hungry-ju.json.
DATABASE_FILE=

# Signing keys. Two distinct secrets, so a leaked access key cannot mint long-lived
# sessions. The API refuses to start in production without both.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Browser origins allowed to call the API with credentials, comma separated.
CORS_ORIGINS=http://localhost:3000

# Base URL used to build verification and password-reset links.
WEB_APP_URL=http://localhost:3000

# Outside production, mail is written to the log instead of sent, and the link comes back
# in the response so the flow is demonstrable without a mail provider.
MAIL_TO_CONSOLE=true

# silent | debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Web client (apps/web)
# ---------------------------------------------------------------------------

# Origin the Next.js rewrite forwards /api/* to. Server-side only: the browser always
# calls a same-origin /api path, so this never reaches the client bundle.
API_ORIGIN=http://localhost:4000
